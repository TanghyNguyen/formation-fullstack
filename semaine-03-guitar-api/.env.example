# Fournisseur IA : ollama (local, gratuit) | groq (cloud gratuit) | openai (payant)
AI_PROVIDER="ollama"

# --- Ollama (recommandé en local, sans quota) ---
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.1:8b"

# --- Groq (gratuit en cloud, pour Railway/Vercel) ---
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.1-8b-instant"

# --- OpenAI (payant) ---
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# Fallback rule-based si l'IA échoue (true par défaut)
OPENAI_FALLBACK="true"
