# Fournisseur IA : groq (cloud, = prod) | ollama (local) | openai (payant)
AI_PROVIDER="groq"

# --- Groq (recommandé : même comportement en local et en prod) ---
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.1-8b-instant"

# --- Ollama (local, sans quota) ---
# AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3.1:8b"

# --- OpenAI (payant) ---
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# Fallback rule-based si l'IA échoue (true par défaut)
OPENAI_FALLBACK="true"

# Cache des progressions IA (1h par défaut)
PROGRESSIONS_CACHE="true"
PROGRESSIONS_CACHE_TTL="3600"
